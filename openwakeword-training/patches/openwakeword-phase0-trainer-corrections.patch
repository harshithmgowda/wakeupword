+# LOCAL PATCH: build the per-class label transforms without hardcoding
+# "positive" as the only positive-labelled class.
+#
+# Upstream did:
+#
+#     for key in ["positive"] + list(config["feature_data_files"].keys()) + ["adversarial_negative"]:
+#         if key == "positive":
+#             label_transforms[key] = lambda x: [1 for i in x]
+#         else:
+#             label_transforms[key] = lambda x: [0 for i in x]
+#
+# and only assigned `config["feature_data_files"]["positive"]` *after* that loop, so
+# the loop had no way to recognise a second positive class. Any extra positive class
+# in `feature_data_files` -- e.g. real over-music recordings given their own class
+# key so that their share of each batch is a hyperparameter instead of an accident
+# of corpus size -- was therefore trained as a NEGATIVE, with no error and no
+# warning. Only a silently worse model.
+def make_label_transforms(class_keys, positive_classes=None):
+    """Map each feature-data class key to a label transform (1 = wake word, 0 = not).
+
+    A class is positive if its key is exactly "positive", starts with "positive_",
+    or is named in the training config's optional `positive_classes` list.
+
+    Args:
+        class_keys (iterable): the class keys batches will be built from
+        positive_classes (iterable): extra keys to label positive, from the config
+
+    Returns:
+        dict: {class key: callable mapping a batch of labels to a list of 0/1}
+    """
+    class_keys = list(class_keys)
+    extra_positives = set(positive_classes or [])
+
+    unknown = extra_positives.difference(class_keys)
+    if unknown:
+        logging.warning(f"`positive_classes` names {sorted(unknown)}, which are not among the "
+                        f"feature data classes {sorted(set(class_keys))} -- check for a typo, "
+                        "as an unmatched name has no effect.")
+
+    def is_positive(key):
+        return key == "positive" or key.startswith("positive_") or key in extra_positives
+
+    label_transforms = {}
+    for key in class_keys:
+        if is_positive(key):
+            label_transforms[key] = lambda x: [1 for i in x]
+        else:
+            label_transforms[key] = lambda x: [0 for i in x]
+
+    positives = sorted(k for k in label_transforms if is_positive(k))
+    logging.info(f"Positive-labelled feature classes: {positives}")
+
+    return label_transforms
+
+
