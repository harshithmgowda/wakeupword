+def _load_audio(path):
+    """LOCAL PATCH: bit-identical, much cheaper stand-in for `torchaudio.load`.
+
+    torchaudio 2.5's `load` goes through a dispatcher that re-resolves the
+    backend and re-probes the file on EVERY call. The decode itself is ~0.1 ms;
+    the dispatcher is the rest. Same failure mode as the tflite thread-count
+    bug: per-call library overhead swamping the actual work.
+
+    Measured on this box, 500 real PCM_16 clips, best of 3, warm cache:
+        torchaudio.load                    2.101 ms/clip
+        soundfile.read(dtype="float32")    0.115 ms/clip     18.3x
+
+    Bit-identical, not merely close: `torch_audiomentations` already forces the
+    soundfile backend at import, so this is the same libsndfile underneath and
+    the same float32 scaling. Verified with `torch.equal` on real clips drawn
+    from every corpus shape this pipeline reads (positives, tv_mix, fma,
+    audioset_16k, mit_rirs) -- see tests/test_clip_loader_equivalence.py.
+
+    The `except` fallback is deliberate and must stay: anything libsndfile
+    cannot open (or opens differently) goes back to torchaudio rather than
+    silently changing shape or dtype.
+    """
+    try:
+        data, sr = soundfile.read(path, dtype="float32", always_2d=True)
+    except Exception:
+        return torchaudio.load(path)
+    # soundfile gives (samples, channels); torchaudio gives (channels, samples).
+    return torch.from_numpy(np.ascontiguousarray(data.T)), sr
+
+
