+def _assemble_batch(x, device):
+    """LOCAL PATCH: move a training batch to `device`, doing any dtype
+    widening THERE rather than on one CPU core.
+
+    `mmap_batch_generator(stack=False)` yields the per-class arrays unstacked
+    (as a list of tensors, once the DataLoader has converted them). 1152 of a
+    v7 batch's 1264 rows come from float16 files -- the ACAV100M 2000 h bank
+    and media_negatives -- and upstream's `np.vstack` widened all of them to
+    float32 single-threaded before anything reached the GPU. Measured on this
+    box, real v7 feature files, batch (1252, 16, 96), 400 steps after 40
+    warm-up, both timers containing the identical mmap read:
+
+        A  np.vstack (CPU upcast) + .to(cuda)  -- as shipped   4.300 ms/step
+        B  per-class .to(cuda) -> widen -> torch.cat           0.970 ms/step
+                                                               4.43x
+
+    fwd+bwd+opt on the same 102,849-parameter model is 2.051 ms/step.
+    (Pinned staging buffers were measured SLOWER than B and are deliberately
+    not used.)
+
+    HONEST END-TO-END CAVEAT -- do not quote the 4.43x as a training-stage
+    speedup. Measured on the real loop, 2000 steps, 3 repeats, best of each:
+
+        bare fwd/bwd/opt loop, prefetch OFF   8.43 -> 3.37 ms/step   2.50x
+        bare fwd/bwd/opt loop, prefetch ON    4.32 -> 3.50 ms/step   1.24x
+        through Model.train_model             8.63 -> 8.51 ms/step   1.01x
+
+    Two things absorb it. `prefetch_generator` (already present) runs the
+    generator on a background thread, so the np.vstack was ALREADY overlapped
+    with the GPU step. And `train_model` itself spends ~5 ms/step on its own
+    bookkeeping -- `loss.detach().cpu().numpy()`, `self.recall(...).cpu()` and
+    the per-step weight tensor each force a device synchronisation -- which
+    dominates whatever the batch path costs. This change is kept because it is
+    bit-identical, halves the host->device bytes (7.7 MB -> 4.1 MB per step),
+    and becomes load-bearing the moment those per-step syncs are addressed;
+    it is NOT kept on the strength of a training-stage wall-clock win, because
+    there is not currently a measurable one.
+
+    The result is bit-identical, and not by luck: the target dtype is computed
+    with the SAME promotion rule numpy applied (torch.promote_types folded over
+    the inputs, so an all-float16 batch still yields float16 exactly as
+    np.vstack would), and float16 -> float32 is an exact widening with a unique
+    result. Asserted, not assumed -- see tests/test_batch_assembly.py.
+
+    Accepts an already-stacked tensor too, so `stack=True` callers and any
+    other DataLoader keep working unchanged.
+    """
+    if not isinstance(x, (list, tuple)):
+        return x.to(device)
+    parts = [t.to(device) for t in x]
+    dtype = parts[0].dtype
+    for t in parts[1:]:
+        dtype = torch.promote_types(dtype, t.dtype)
+    return torch.cat([t.to(dtype) for t in parts], dim=0)
+
+
