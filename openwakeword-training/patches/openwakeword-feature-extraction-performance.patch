 # Alternate data augmentation method using audiomentations library (https://pypi.org/project/audiomentations/)
+def build_background_cache(background_clip_paths, total_length, cache_path, sr=16000,
+                           max_segments_per_file=None):
+    """Pre-decode the background-noise pool into fixed-length segments on disk.
+
+    LOCAL PATCH. `AddBackgroundNoise` re-reads its background audio from the
+    filesystem on every call, and in mode="per_example" that is once per clip in the
+    batch. Measured on this machine, one 32-clip batch spent ~507 ms inside
+    AddBackgroundNoise -- 64 file operations (a metadata probe plus a seek-and-decode
+    per example) scattered across a 7398-file, 3.89 GB pool -- against ~20 ms for
+    every other augmentation in the batch combined. It was the single largest cost in
+    the pipeline once feature extraction was fixed.
+
+    Writing the pool once as one `int16` memmap of `total_length`-sample segments
+    turns each of those reads into an array slice: the same batch drops to ~5.6 ms,
+    a ~90x reduction. Segments are memmapped rather than held in RAM so the cache
+    can exceed memory (the full pool here is ~3.9 GB against 23 GB of RAM that also
+    has to hold a 17 GB feature memmap); the OS page cache keeps the hot parts
+    resident.
+
+    Alongside the segments, a per-source-file index is stored so that sampling can
+    stay faithful to upstream: upstream draws a *file* uniformly and then a random
+    offset inside it, so drawing a file uniformly and then one of its segments
+    preserves that weighting. Sampling segments uniformly instead would silently
+    re-weight the pool toward longer files (a 30 s track yields 15 segments, a 10 s
+    clip only 5).
+
+    Args:
+        background_clip_paths (List[str]): Background audio files. Duplicates are
+            fine and are collapsed here -- per-source weighting is applied at
+            sampling time via `random.choice` over the caller's list, exactly as
+            upstream does.
+        total_length (int): Segment length in samples; must match the `total_length`
+            the clips are augmented at.
+        cache_path (str): Output .npy path. A companion `<cache_path>.index.npz` is
+            written next to it.
+        sr (int): Expected sample rate of the background files.
+        max_segments_per_file (int): Optional cap on segments taken per file.
+
+    Returns:
+        None
+    """
+    unique_paths = sorted({str(Path(os.path.abspath(p))) for p in background_clip_paths})
+    logging.info(f"Building background-noise cache from {len(unique_paths)} unique files "
+                 f"at {total_length} samples/segment -> {cache_path}")
+
+    # First pass: count segments per file so the memmap can be sized exactly.
+    starts, counts, kept = [], [], []
+    running = 0
+    for p in tqdm(unique_paths, desc="Scanning background files"):
+        try:
+            info = torchaudio.info(p)
+        except Exception as e:
+            logging.warning(f"Skipping unreadable background file {p}: {e}")
+            continue
+        if info.sample_rate != sr:
+            logging.warning(f"Skipping background file with sample rate {info.sample_rate} "
+                            f"(expected {sr}): {p}")
+            continue
+        n = int(info.num_frames)//total_length
+        if max_segments_per_file:
+            n = min(n, max_segments_per_file)
+        if n < 1:
+            continue
+        kept.append(p)
+        starts.append(running)
+        counts.append(n)
+        running += n
+
+    if running == 0:
+        raise ValueError("No usable background files found while building the background cache "
+                         f"(need at least {total_length} samples at {sr} Hz).")
+
+    fp = open_memmap(cache_path, mode="w+", dtype=np.int16, shape=(running, total_length))
+    for p, start, count in tqdm(list(zip(kept, starts, counts)), desc="Caching background segments"):
+        # normalize=False keeps PCM_16 sources as exact int16, so the cache holds the
+        # same sample values the file-reading path would decode. Round-tripping
+        # through float and back would perturb every sample by up to half an LSB.
+        data, _ = torchaudio.load(p, normalize=False)
+        if data.dtype != torch.int16:
+            data, _ = torchaudio.load(p)
+            data = (data*32768.0).clamp(-32768, 32767).to(torch.int16)
+        data = data[0].numpy()
+        for k in range(count):
+            fp[start + k] = data[k*total_length:(k + 1)*total_length]
+    fp.flush()
+    del fp
+
+    np.savez(cache_path + ".index.npz",
+             paths=np.array(kept),
+             starts=np.array(starts, dtype=np.int64),
+             counts=np.array(counts, dtype=np.int64),
+             total_length=np.array([total_length], dtype=np.int64))
+    logging.info(f"Background cache built: {running} segments "
+                 f"({running*total_length*2/1e9:.2f} GB) from {len(kept)} files")
+
+
+def load_background_cache(cache_path, total_length):
+    """Load a cache written by `build_background_cache`, validating its geometry."""
+    index_path = cache_path + ".index.npz"
+    if not (os.path.exists(cache_path) and os.path.exists(index_path)):
+        return None, None
+    idx = np.load(index_path, allow_pickle=False)
+    cached_length = int(idx["total_length"][0])
+    if cached_length != total_length:
+        # Silently reusing a cache cut at a different length would mix clip
+        # geometries, so make it loud rather than subtly wrong.
+        raise ValueError(
+            f"Background cache {cache_path} holds {cached_length}-sample segments but "
+            f"total_length is {total_length}. Delete it to have it rebuilt."
+        )
+    segments = np.load(cache_path, mmap_mode="r")
+    path_index = {p: (int(s), int(c))
+                  for p, s, c in zip(idx["paths"].tolist(), idx["starts"], idx["counts"])}
+    return segments, path_index
+
+
+class CachedAddBackgroundNoise(torch_audiomentations.AddBackgroundNoise):
+    """`AddBackgroundNoise` that reads its background audio from a memmapped cache.
+
+    LOCAL PATCH. Only `random_background` is overridden, so every part of the
+    augmentation that affects the *result* -- the SNR draw, the RMS normalisation,
+    the mixing in `apply_transform` -- is inherited from upstream unchanged.
+
+    Two deliberate differences from upstream, neither of which changes the
+    distribution being sampled:
+
+    - The window inside a source file is chosen from that file's fixed segment
+      boundaries rather than an arbitrary sample offset. Both are "a random
+      `total_length` window from this file"; only the granularity differs.
+    - Segment amplitude is scaled by 1/32768 to undo the int16 storage. Upstream's
+      `rms_normalize` divides any positive scale factor straight back out, so this
+      cannot shift the result.
+
+    A file is still drawn with `random.choice(self.background_paths)` -- the caller's
+    list, including any duplicates from `background_paths_duplication_rate` -- so
+    per-source weighting is identical to upstream.
+    """
+
+    def __init__(self, *args, segments=None, path_index=None, **kwargs):
+        super().__init__(*args, **kwargs)
+        if segments is None or path_index is None:
+            raise ValueError("CachedAddBackgroundNoise requires segments and path_index")
+        self._segments = segments
+        self._path_index = path_index
+        self._missing_warned = False
+        missing = {str(p) for p in self.background_paths} - set(path_index)
+        if missing:
+            logging.warning(
+                f"{len(missing)} of {len(self.background_paths)} background paths are absent "
+                "from the cache (unreadable or shorter than total_length when it was built); "
+                "those draws fall back to reading from disk."
+            )
+        self._missing = missing
+
+    def random_background(self, audio, target_num_samples):
+        # Fall back to upstream for anything the cache cannot serve, so a stale or
+        # partial cache degrades in speed rather than in correctness.
+        if target_num_samples > self._segments.shape[1]:
+            return super().random_background(audio, target_num_samples)
+
+        background_path = random.choice(self.background_paths)
+        key = str(background_path)
+        if key in self._missing:
+            return super().random_background(audio, target_num_samples)
+
+        start, count = self._path_index[key]
+        # Don't consume randomness when there is nothing to choose between. Upstream's
+        # single-segment case (source file exactly target_num_samples long) takes a
+        # branch that draws no second random number, so skipping it here keeps the RNG
+        # stream aligned with upstream's for that case instead of shifting every
+        # subsequent draw.
+        seg_ndx = 0 if count == 1 else random.randrange(count)
+        segment = self._segments[start + seg_ndx][:target_num_samples]
+        piece = torch.from_numpy(np.asarray(segment, dtype=np.float32)/32768.0)[None, :]
+        return audio.rms_normalize(audio.rms_normalize(piece))
+
