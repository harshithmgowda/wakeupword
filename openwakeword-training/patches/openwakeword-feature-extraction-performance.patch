index 5f64e03..7b538fe 100644
--- a/openwakeword/utils.py
+++ b/openwakeword/utils.py
@@ -28,6 +28,166 @@ from typing import Union, List, Callable, Deque
 import requests
 
 
+# LOCAL PATCH: helpers for choosing where feature extraction runs, and for
+# overlapping a producer generator with its consumer. Both exist because the
+# feature-extraction stage was the dominant cost of the whole training pipeline
+# (2 h 48 m of a 3 h 03 m run) while the GPU sat at a ~1-2% duty cycle.
+def onnx_gpu_available():
+    """True if onnxruntime advertises a CUDA execution provider.
+
+    This is deliberately NOT `torch.cuda.is_available()`. The two are independent:
+    a CPU-only `onnxruntime` wheel reports no CUDA provider no matter what torch
+    sees, and asking such a build for "CUDAExecutionProvider" only produces a
+    warning and a silent fall back to CPU. Deciding thread counts from torch's view
+    of CUDA is what pinned feature extraction to a single core on this machine.
+
+    Note this is necessary but NOT sufficient: onnxruntime-gpu ships the CUDA
+    provider as a separate shared library that fails to load unless cuBLAS/cuDNN
+    are already resident in the process (here they arrive via the nvidia/* wheels
+    that torch depends on, so importing torch first is what makes it work). Callers
+    must therefore check what an actual session reports -- see
+    `compute_features_from_generator`, which re-picks its thread count if the
+    provider it asked for is not the one it got.
+    """
+    try:
+        import onnxruntime as ort
+    except ImportError:
+        return False
+    return "CUDAExecutionProvider" in ort.get_available_providers()
+
+
+def cpu_feature_threads(max_threads=None):
+    """Thread count to use when features are computed on the CPU.
+
+    Default 8 rather than `os.cpu_count()`: measured on this 24-core machine, one
+    32-clip batch takes 520 ms at 1 thread and 90 ms at 8, then stays flat (91 ms
+    at 16, 91 ms at 24). So 8 captures essentially all of the available gain and
+    leaves cores for the augmentation stage feeding it; under CPU contention the
+    higher counts actively regressed. Override with OWW_FEATURE_THREADS.
+    """
+    if max_threads is None:
+        max_threads = int(os.environ.get("OWW_FEATURE_THREADS", 8))
+    return max(1, min(max_threads, os.cpu_count() or 1))
+
+
+def select_feature_device():
+    """Pick the (device, ncpu) pair for computing openwakeword features.
+
+    `ncpu` is meaningful on both devices. Since melspectrogram.onnx has to be called
+    one clip at a time (see `_get_melspectrogram_batch`), the ThreadPool is what
+    hides per-call latency even on GPU: a 32-clip batch takes 32.5 ms with 1 thread
+    but 16.3 ms with 8.
+
+    Measured per 32-clip batch, all numerically equivalent (<= 8.2e-07 relative to
+    the all-CPU reference, which is what every model in this repo was trained on):
+
+        all CPU, 1 thread  (the old behaviour)   520 ms
+        all CPU, 8 threads                        90 ms
+        GPU, 8 threads                            16 ms
+
+    Force the choice with OWW_FEATURE_DEVICE=cpu|gpu.
+    """
+    device = os.environ.get("OWW_FEATURE_DEVICE", "").strip().lower()
+    if device not in ("cpu", "gpu"):
+        device = "gpu" if onnx_gpu_available() else "cpu"
+    return device, cpu_feature_threads()
+
+
+def prefetch_generator(generator, queue_size=4):
+    """Run `generator` on a background thread, yielding its items to the caller.
+
+    Used to overlap `augment_clips` with feature extraction, which are otherwise
+    strictly sequential inside `compute_features_from_generator` -- one batch is
+    augmented, then embedded, then the next is augmented. The two halves stress
+    different resources (the augmentation is dominated by background-noise file
+    reads, the consumer by onnxruntime inference) and both release the GIL, so a
+    single worker thread genuinely overlaps them.
+
+    A thread rather than a process on purpose: the augmentation generator holds
+    CUDA tensors and unpicklable transform objects, and one worker means the
+    module-level RNGs in `audiomentations` are still touched by exactly one
+    thread at a time. Set OWW_PREFETCH=0 to disable.
+    """
+    import queue
+    import threading
+
+    if os.environ.get("OWW_PREFETCH", "1") == "0":
+        yield from generator
+        return
+
+    q = queue.Queue(maxsize=max(1, queue_size))
+    done = object()
+
+    def _worker():
+        try:
+            for item in generator:
+                q.put(item)
+        except BaseException as e:  # forwarded to the consumer thread below
+            q.put(e)
+        else:
+            q.put(done)
+
+    thread = threading.Thread(target=_worker, name="oww-prefetch", daemon=True)
+    thread.start()
+
+    while True:
+        item = q.get()
+        if item is done:
+            return
+        if isinstance(item, BaseException):
+            raise item
+        yield item
+
+
+class TensorBatches:
+    """Iterate contiguous (x, y) slices of two fixed tensors.
+
+    A drop-in replacement for
+        DataLoader(TensorDataset(x, y), batch_size=len(y))
+    which is how upstream fed the false-positive validation set. That construction
+    is pathological: with batch_size == len(dataset) the default fetcher calls
+    __getitem__ once per row and then default_collate-stacks the results, so the
+    481,329-row / 2.96 GB false-positive set cost 8.35 s to produce a single batch
+    -- and it was rebuilt from scratch at every validation step (20 steps per
+    training sequence x 3 sequences = 60 times per run, ~9 min of a ~15 min
+    training stage). Slicing a contiguous tensor instead is a view: ~0 s.
