+            )
+        ]
+        missing = [f for f in feature_files if not os.path.exists(f)]
+        if missing and len(missing) < len(feature_files):
+            logging.warning(
+                f"Found an incomplete feature set ({len(missing)} of "
+                f"{len(feature_files)} files missing), which means an earlier "
+                f"augmentation run was interrupted. Regenerating all of them. "
+                f"Missing: {', '.join(os.path.basename(f) for f in missing)}"
+            )
