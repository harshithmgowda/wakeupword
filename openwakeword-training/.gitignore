# Persisted embedding caches (embed_cache.py). Regenerable, ~0.4 GB for the
# 24h FA corpus; the manifest.json inside would otherwise be tracked.
.embed_cache/
.embed_cache_v2/

# perf_audit/ lives on the experiments branch, where the benchmark scripts and
# their small JSON/MD results are tracked. The underscore-prefixed entries are
# the bulky captured intermediates (embedding caches, dumped tensors, file
# listings), ~400 MB, regenerable by re-running the benchmarks -- never tracked
# on either branch, so the rule stays here.
perf_audit/_*

# scratch directories some tests create and reuse
tests/_tmp_*/
